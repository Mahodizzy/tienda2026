rules_version = '2';

// =============================================================
// Reglas de seguridad de Refills EC
// Cópialas en: Firebase → Firestore Database → Reglas → Publicar
//
// • Cada cliente solo puede ver y crear SUS pedidos.
// • Nadie puede cambiar un pedido desde la página (estado, precio,
//   entrega): eso solo lo hace tu bot de Telegram con la cuenta
//   de servicio, que no pasa por estas reglas.
// • El chat lo escribe solo el bot; el cliente únicamente lo lee.
// • Los productos y datos de la tienda solo los cambia tu cuenta
//   de administrador (colección "admins").
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }
    function esDueno(uid) {
      return conSesion() && request.auth.uid == uid;
    }
    function esAdmin() {
      return conSesion() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Datos de la tienda (productos, precios, redes, cuentas y la promoción):
    // todos los pueden leer, solo tu app de administrador los cambia.
    match /tienda/{documento} {
      allow read: if true;
      allow write: if esAdmin() && documento in ['config', 'catalogo', 'paginas'];
      allow write: if esAdmin() && documento == 'promo'
        && (!('imagen' in request.resource.data)
            || (request.resource.data.imagen is string && request.resource.data.imagen.size() < 950000));
    }

    // Lista de administradores: se crea a mano en la consola de Firebase.
    match /admins/{uid} {
      allow read: if esDueno(uid);
      allow write: if false;
    }

    match /pedidos/{pedidoId} {
      // El cliente ve sus pedidos; tu cuenta de administrador ve todos (sección Clientes).
      allow read: if esDueno(resource.data.uid) || esAdmin();

      allow create: if esDueno(request.resource.data.uid)
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'nombre', 'codigo', 'items', 'total', 'ahorro',
             'metodo', 'whatsapp', 'estado', 'notificado', 'creado', 'actualizado'])
        && request.resource.data.estado == 'en_revision'
        && request.resource.data.notificado == false
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() <= 20
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total < 5000
        && request.resource.data.ahorro is number
        && request.resource.data.ahorro >= 0
        && request.resource.data.metodo is map
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() <= 20
        && request.resource.data.creado == request.time;

      // El panel solo puede completar el vencimiento de pedidos antiguos y anotar el costo.
      // (Aprobar, rechazar y entregar pasan por el puente, para avisar al cliente y a Telegram.)
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vence', 'costo'])
        && (!('vence' in request.resource.data) || request.resource.data.vence is timestamp)
        && (!('costo' in request.resource.data) || request.resource.data.costo == null
            || (request.resource.data.costo is number && request.resource.data.costo >= 0));
      allow delete: if false;
    }

    // Foto del comprobante: la ven su dueño y tu cuenta de administrador.
    match /comprobantes/{pedidoId} {
      allow read: if esDueno(resource.data.uid) || esAdmin();

      allow create: if esDueno(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid', 'imagen', 'creado'])
        && request.resource.data.imagen is string
        && request.resource.data.imagen.size() < 950000
        && getAfter(/databases/$(database)/documents/pedidos/$(pedidoId)).data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    // Chat de soporte: el cliente lee su conversación; el bot la escribe.
    match /chats/{uid} {
      allow read: if esDueno(uid);
      allow write: if false;

      match /mensajes/{mensajeId} {
        allow read: if esDueno(uid);
        allow write: if false;
      }
    }

    // Uso interno del bot.
    match /soporteTemas/{tema} {
      allow read, write: if false;
    }

    // Todo lo demás está cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
